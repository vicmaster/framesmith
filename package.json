{
  "name": "framesmith",
  "version": "2.3.0",
  "description": "Open-source MCP server that turns your AI coding agent into a UI designer: a visual canvas, vetted design patterns, and a quality gate every design must pass before you see it. HTML/CSS, open JSON, any MCP client.",
  "type": "module",
  "bin": {
    "framesmith": "./dist/index.js",
    "framesmith-viewer": "./dist/viewer-standalone.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "docs/GUIDELINES.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "viewer": "tsx src/viewer-standalone.ts",
    "bench": "tsx benchmark/run.ts",
    "test": "npm run test:fast",
    "test:fast": "tsx scripts/run-tests.ts",
    "test:full": "tsx scripts/run-tests.ts --full"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.96.0",
    "@material-symbols/svg-400": "^0.44.12",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "lucide-static": "^0.577.0",
    "nanoid": "^5.1.5",
    "openai": "^6.38.0",
    "puppeteer": "^24.7.2",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  },
  "license": "MIT"
}
